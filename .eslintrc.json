{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "eslint-config-next"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "react/no-unknown-property": ["warn", { "ignore": ["aria-*", "data-*"] }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-restricted-globals": "off",
    "no-unused-vars": "warn"
  }
}